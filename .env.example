# Supabase Credentials (leave empty or set for live remote cluster)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# AI Provider Configuration (Claude / OpenAI / Deterministic Local Mock)
LLM_PROVIDER="mock" # "anthropic" | "openai" | "mock"
ANTHROPIC_API_KEY=""

# Speech-to-Text Provider (Whisper / Bhashini / Mock)
STT_PROVIDER="mock" # "browser" | "bhashini" | "whisper" | "mock"

# HMAC Secret for Challenge Signing
CHALLENGE_HMAC_SECRET="satya-rpl-sih-2026-super-secret-challenge-key-32chars"

# App Environment
NEXT_PUBLIC_APP_ENV="development"
